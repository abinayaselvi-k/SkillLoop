rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isLessThan5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Profile photos directory: profile_photos/{userId}/{fileName}
    match /profile_photos/{userId}/{fileName} {
      // Anyone can read public avatar images
      allow read: if true;

      // Only the user themselves can upload or update their avatar (max 5MB, image only)
      allow write: if isOwner(userId) && isImage() && isLessThan5MB();

      allow delete: if isOwner(userId);
    }
  }
}
